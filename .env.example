# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_drift
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campus_drift

# Security & JWT
SECRET_KEY=supersecretkeycampusdriftchangeinproduction1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
ENVIRONMENT=development
DEBUG=True
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000"]
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Redis & Celery Asynchronous Worker Queue (ADR-003)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_POLL_INTERVAL_SECONDS=3600.0

# External ITSM Webhook Integration (HMAC-SHA256 Signature Verification)
ITSM_WEBHOOK_SECRET=itsm_webhook_shared_secret_campus_drift_2026

# Frontend: show demo role cards on the login page (set false in production)
VITE_DEMO_MODE=true

# Remediation pushes run on the Celery worker (queue "remediation") when true. Unset = true in production, false otherwise.
# The worker must consume that queue: celery -A app.core.celery_app.celery_app worker -Q celery,remediation
# REMEDIATION_USE_QUEUE=true

# Sign-in protection: this many wrong passwords for one username and address lock it for the window (seconds).
# LOGIN_MAX_FAILURES=5
# LOGIN_FAILURE_WINDOW_SECONDS=900
